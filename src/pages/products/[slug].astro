---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import { Icons } from "../../lib/icons.js";
import { asset, imageUrl, validImages } from "../../lib/images.js";
import { products, getRelated, productUrl, categoryUrl, stripHtml, truncate, SITE } from "../../lib/products.js";
import { priceParts } from "../../lib/price.js";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const images = validImages(product.images);
const fitClass = product.imageFit === "contain" ? "object-contain" : "";
const parts = priceParts(product);
const related = getRelated(product, 4);
const url = `${SITE}${productUrl(product)}`;
const fullName = product.subName ? `${product.name} ${product.subName}` : product.name;

const mainUrls = await Promise.all(images.map((img) => imageUrl(img, 1200)));
const isChart = (p) => /size-chart\./.test(p);
const absImages = mainUrls.filter((_, i) => !isChart(images[i])).map((u) => `${SITE}${u}`);
const pageTitle = product.seoTitle || `${fullName} | Golden Motif`;

const eur = product.pricing?.EUR;
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: fullName,
  description: stripHtml(product.description),
  sku: product.sku,
  image: absImages,
  material: product.material,
  category: product.category,
  brand: { "@type": "Brand", name: "Golden Motif" },
  url,
};
if (typeof eur === "number") {
  productSchema.offers = {
    "@type": "Offer",
    price: eur,
    priceCurrency: "EUR",
    url: product.EtsyLink || url,
    ...(product.availability === "Available" ? { availability: "https://schema.org/InStock" } : {}),
  };
}
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` },
    { "@type": "ListItem", position: 2, name: "Catalogue", item: `${SITE}/catalogue/` },
    { "@type": "ListItem", position: 3, name: product.category, item: `${SITE}${categoryUrl(product.category)}` },
    { "@type": "ListItem", position: 4, name: product.name, item: url },
  ],
};

const metaDescription = truncate(product.description);
---
<Base
  title={pageTitle}
  description={metaDescription}
  ogTitle={pageTitle}
  ogDescription={metaDescription}
  ogType="product"
  ogImage={absImages[0]}
  path={productUrl(product)}
  active="catalogue"
  jsonLd={[productSchema, breadcrumbSchema]}
>
  <main id="main-content">
    <section class="product-detail section" id="product-detail" aria-label="Product details" data-pricing={JSON.stringify(product.pricing || {})}>
      <div class="container">
        <div class="product-detail__grid">
          <div class="product-gallery">
            <div class="product-gallery__main-outer">
              <button class="product-gallery__main-nav prev" id="main-prev" aria-label="Previous image">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
              </button>
              <div class={`product-gallery__main ${fitClass}`}>
                {images[0] && (
                  <Image src={asset(images[0])} alt={product.name} id="gallery-main-img" widths={[600, 900, 1200]} sizes="(max-width: 900px) 100vw, 600px" format="webp" loading="eager" />
                )}
              </div>
              <button class="product-gallery__main-nav next" id="main-next" aria-label="Next image">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            </div>

            <div class="product-gallery__thumbs" id="gallery-thumbs">
              {images.map((img, i) => (
                <button class={`product-gallery__thumb ${i === 0 ? "active" : ""}`} data-img={mainUrls[i]} data-index={i} aria-label={`View image ${i + 1}`}>
                  <Image src={asset(img)} alt={isChart(img) ? `${product.name} size chart` : `${fullName} view ${i + 1}`} width={160} format="webp" loading="lazy" />
                </button>
              ))}
            </div>
          </div>

          <div class="product-info">
            <nav class="product-info__breadcrumb" aria-label="Breadcrumb">
              <a href="/">Home</a>
              <span>›</span>
              <a href="/catalogue/">Catalogue</a>
              <span>›</span>
              <a href={categoryUrl(product.category)}>{product.category}</a>
              <span>›</span>
              <span>{product.name}</span>
            </nav>

            <span class="product-info__category">{product.category}</span>
            <h1 class="product-info__name">
              {product.name}
              {product.subName && <span class="product-info__subtitle">{product.subName}</span>}
            </h1>
            <div class="product-info__price" data-price-detail>
              {parts.hasAmount ? (
                <>
                  <span class={`product-info__price-amount${parts.isCodePrefix ? " is-code" : ""}`} aria-label={parts.amountText}>
                    <span class="product-info__price-symbol">{parts.symbolText}</span>
                    <span class="product-info__price-value">{parts.valueText}</span>
                  </span>
                  <span class="product-info__price-note">{parts.noteText}</span>
                </>
              ) : (
                <span class="product-info__price-note is-only">{parts.noteText}</span>
              )}
            </div>
            <p class="product-info__desc" set:html={product.description}></p>

            <div class="product-info__meta">
              <div class="product-info__meta-row">
                <span class="product-info__meta-label">Material</span>
                <span class="product-info__meta-value">{product.material}</span>
              </div>
              <div class="product-info__meta-row">
                <span class="product-info__meta-label">SKU</span>
                <span class="product-info__meta-value">{product.sku}</span>
              </div>
              <div class="product-info__meta-row">
                <span class="product-info__meta-label">Availability</span>
                <span class="product-info__availability">{product.availability || "Available"}</span>
              </div>
            </div>

            {product.EtsyLink && (
              <div class="product-info__buttons" style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                <a href={product.EtsyLink} class="btn btn--primary" target="_blank" rel="noopener" data-etsy-link>
                  <Fragment set:html={Icons.mail} /> BUY NOW ON ETSY
                </a>
                <span style="font-size: 0.9em; color: #555;">Secure checkout and buyer protection through Etsy</span>
              </div>
            )}

            <div class="product-info__buttons">
              <a href="/contact/" class="btn btn--primary">
                <Fragment set:html={Icons.mail} /> REQUEST WHOLESALE PRICE
              </a>
            </div>

            <div class="accordion mt-xl">
              <div class="accordion__item">
                <button class="accordion__trigger" aria-expanded="false">
                  Product Information
                  <span class="accordion__icon"></span>
                </button>
                <div class="accordion__content">
                  <div class="accordion__content-inner">
                    {product.productInfo ? (
                      <Fragment set:html={product.productInfo} />
                    ) : (
                      <>
                        <p set:html={product.description}></p>
                        <p style="margin-top: 0.75rem;">Each piece is individually inspected for quality and ships with a certificate of authenticity. Our artisans take pride in every stitch, ensuring that your Golden Motif product will age gracefully and become a trusted companion for years to come.</p>
                      </>
                    )}
                  </div>
                </div>
              </div>

              <div class="accordion__item">
                <button class="accordion__trigger" aria-expanded="false">
                  Materials &amp; Care
                  <span class="accordion__icon"></span>
                </button>
                <div class="accordion__content">
                  <div class="accordion__content-inner">
                    {product.materialInfo ? <Fragment set:html={product.materialInfo} /> : <p><strong>Material:</strong> {product.material}</p>}
                    {product.careInfo ? (
                      <Fragment set:html={product.careInfo} />
                    ) : (
                      <p style="margin-top: 0.75rem;"><strong>Care:</strong> To preserve the natural beauty of your leather, keep it away from prolonged moisture and direct sunlight. Clean with a soft, dry cloth. We recommend conditioning with a quality leather balm every 3–6 months depending on use.</p>
                    )}
                  </div>
                </div>
              </div>

              <div class="accordion__item">
                <button class="accordion__trigger" aria-expanded="false">
                  Shipping &amp; Lead Time
                  <span class="accordion__icon"></span>
                </button>
                <div class="accordion__content">
                  <div class="accordion__content-inner">
                    {product.shippingInfo ? (
                      <Fragment set:html={product.shippingInfo} />
                    ) : (
                      <p>Most orders ship within 7–20 business days, depending on the item. Made-to-order and custom items may take up to 3–4 weeks for crafting. We ship worldwide via insured courier. Contact us for bulk or custom orders with specific delivery requirements.</p>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {product.about && (
      <section class="section--sm product-about" aria-labelledby="about-title">
        <div class="container container--narrow">
          <h2 class="section-title" id="about-title" style="text-align:left;">About the {product.name}</h2>
          <div class="product-about__text" set:html={product.about}></div>
          <p style="margin-top: 1rem;">
            <a href={categoryUrl(product.category)}>More {product.category.toLowerCase()}</a> ·
            <a href="/materials-and-care/">Materials &amp; care</a> ·
            <a href="/shipping-returns/">Shipping &amp; returns</a> ·
            <a href="/faq/">FAQ</a>
          </p>
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="section section--alt related-products" id="related-products" aria-labelledby="related-title">
        <div class="container">
          <div class="section-header text-center reveal">
            <span class="section-label">You May Also Like</span>
            <h2 class="section-title" id="related-title">Related Products</h2>
          </div>
          <div class="collections-grid">
            {related.map((p, i) => <ProductCard product={p} index={i} />)}
          </div>
        </div>
      </section>
    )}
  </main>
  <script is:inline slot="scripts" src="/js/product-detail.js" defer></script>
</Base>
