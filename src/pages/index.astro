---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { Icons } from "../lib/icons.js";
import { asset } from "../lib/images.js";
import ProductCard from "../components/ProductCard.astro";
import { products } from "../lib/products.js";
import { imageUrl } from "../lib/images.js";
const featuredProducts = [...products.filter((p) => p.featured), ...products.filter((p) => !p.featured)];
const heroUrl = await imageUrl("ASSESTS/Hero Section/hero.jpg", 1920);
const ogImage = "https://www.goldenmotif.com" + (await imageUrl("ASSESTS/Leather Convertible Shoulder Bag & Backpack/1.png", 1200));
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://www.goldenmotif.com/#organization",
        name: "Golden Motif",
        alternateName: "Golden Motif Leather",
        url: "https://www.goldenmotif.com/",
        logo: "https://www.goldenmotif.com/Logo-GoldenMotif.png",
        sameAs: [
          "https://www.instagram.com/goldenmotif6/",
          "https://www.facebook.com/profile.php?id=61589192874405",
          "https://goldenmotifeu.etsy.com",
        ],
      },
      {
        "@type": "WebSite",
        "@id": "https://www.goldenmotif.com/#website",
        url: "https://www.goldenmotif.com/",
        name: "Golden Motif",
        publisher: { "@id": "https://www.goldenmotif.com/#organization" },
      },
    ],
  },
];
---
<Base
  title="Golden Motif — Premium Leather Goods"
  description="Discover Golden Motif's curated collection of handcrafted premium leather goods. Handbags, duffles, wallets, and accessories crafted from the finest leathers."
  ogTitle="Golden Motif — Premium Leather Goods"
  ogDescription="Handcrafted leather goods of enduring quality and timeless design."
  path="/"
  active="home"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
<main id="main-content">
      <!-- ═══════════ HERO ═══════════ -->
      <section
        class="hero"
        aria-labelledby="hero-title"
        style={`background-image: url("${heroUrl}")`}
      >
        <div class="hero__content">
          <span class="hero__label">Premium Leather Goods</span>
          <h1 class="hero__title" id="hero-title">
            Carry Elegance,<br />Define Your <em>Story</em>
          </h1>
          <p class="hero__desc">
            Each Golden Motif piece is a dialogue between heritage<br>
            craft and modern sensibility. Designed to age beautifully,<br>
            carried to tell your story.
          </p>
          <div class="hero__buttons">
            <a href="/catalogue/" class="btn btn--primary btn--lg"
              >Explore Catalogue</a
            >
            <a href="#collections" class="btn btn--outline btn--lg"
              >View Collections</a
            >
          </div>
        </div>
      </section>

      <!-- ═══════════ SIGNATURE COLLECTIONS ═══════════ -->
      <section
        class="section section--alt"
        id="collections"
        aria-labelledby="collections-title"
      >
        <div class="container">
          <div class="section-header text-center reveal">
            <span class="section-label">Our Collection</span>
            <h2 class="section-title" id="collections-title">
              Signature Pieces
            </h2>
            <p class="section-subtitle">
              A curated selection of our most distinguished leather goods, each
              crafted to become an enduring part of your everyday.
            </p>
          </div>
          <div class="collections-grid" id="featured-grid">
            {featuredProducts.map((p, i) => <ProductCard product={p} index={i} eager={i < 4} />)}
          </div>
        </div>
      </section>

      <!-- ═══════════ EDITORIAL SPLIT ═══════════ -->
      <section class="editorial reveal" aria-labelledby="editorial-title">
        <div class="editorial__content">
          <span class="editorial__label">The Art of Craft</span>
          <h2 class="editorial__title" id="editorial-title">
            Where Tradition Meets Intention
          </h2>
          <p class="editorial__text">
            Every hide is selected by hand. Every seam is stitched with purpose.
            We partner with tanneries that share our commitment to sustainable
            sourcing, ensuring each product honors both the material and the
            maker.
          </p>
          <a href="/about/" class="btn btn--ghost">Discover Our Story</a>
          <div class="editorial__stats">
            <div>
              <div class="editorial__stat-value">12+</div>
              <div class="editorial__stat-label">Years of Craft</div>
            </div>
            <div>
              <div class="editorial__stat-value">50+</div>
              <div class="editorial__stat-label">Unique Designs</div>
            </div>
            <div>
              <div class="editorial__stat-value">100%</div>
              <div class="editorial__stat-label">Full-Grain Genuine Leather</div>
            </div>
          </div>
        </div>
        <Image src={asset("ASSESTS/How do w epack your itrms_6/7.png")} alt="Golden Motif artisan carefully stitching leather" class="editorial__image" widths={[480, 800, 1200]} sizes="(max-width: 768px) 100vw, 720px" format="webp" loading="lazy" />
      </section>

      <!-- ═══════════ WHY GOLDEN MOTIF ═══════════ -->
      <section class="section" aria-labelledby="features-title">
        <div class="container">
          <div class="section-header text-center reveal">
            <span class="section-label">Why Choose Us</span>
            <h2 class="section-title" id="features-title">
              The Golden Motif Difference
            </h2>
          </div>
          <div class="grid grid-3">
            <div class="feature-card reveal reveal-delay-1">
              <div class="feature-card__icon">
                <span data-icon="award" set:html={Icons.award}></span>
              </div>
              <h3 class="feature-card__title">Artisanal Quality</h3>
              <p class="feature-card__text">
                Every piece is hand-finished by skilled artisans using
                techniques refined over generations.
              </p>
            </div>
            <div class="feature-card reveal reveal-delay-2">
              <div class="feature-card__icon">
                <span data-icon="shield" set:html={Icons.shield}></span>
              </div>
              <h3 class="feature-card__title">Ethically Sourced</h3>
              <p class="feature-card__text">
                We work exclusively with tanneries committed to responsible
                sourcing and environmental care.
              </p>
            </div>
            <div class="feature-card reveal reveal-delay-3">
              <div class="feature-card__icon">
                <span data-icon="package" set:html={Icons.package}></span>
              </div>
              <h3 class="feature-card__title">Built to Last</h3>
              <p class="feature-card__text">
                Full-grain leathers and solid hardware ensure your piece ages
                gracefully over decades.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══════════ TESTIMONIALS ═══════════ -->
      <section
        class="section section--alt"
        aria-labelledby="testimonials-title"
      >
        <div class="container">
          <div class="section-header text-center reveal">
            <span class="section-label">Testimonials</span>
            <h2 class="section-title" id="testimonials-title">
              Words from Our Patrons
            </h2>
          </div>
          <div class="grid grid-3">
            <div class="testimonial-card reveal reveal-delay-1">
              <div class="testimonial-card__stars">
                {[1, 2, 3, 4, 5].map(() => <span data-icon="star" set:html={Icons.star}></span>)}
              </div>
              <p class="testimonial-card__quote">
                "The Voyager Duffle is the finest bag I've owned. The leather
                has developed an incredible patina after just six months of
                travel."
              </p>
              <div class="testimonial-card__author">
                <div class="testimonial-card__avatar">JR</div>
                <div>
                  <div class="testimonial-card__name">James Richardson</div>
                  <div class="testimonial-card__role">Architect, London</div>
                </div>
              </div>
            </div>
            <div class="testimonial-card reveal reveal-delay-2">
              <div class="testimonial-card__stars">
                {[1, 2, 3, 4, 5].map(() => <span data-icon="star" set:html={Icons.star}></span>)}
              </div>
              <p class="testimonial-card__quote">
                "Golden Motif understands that luxury isn't about logos — it's
                about the quality you can feel the moment you hold one of their
                pieces."
              </p>
              <div class="testimonial-card__author">
                <div class="testimonial-card__avatar">SA</div>
                <div>
                  <div class="testimonial-card__name">Sarah Ashworth</div>
                  <div class="testimonial-card__role">
                    Creative Director, Milan
                  </div>
                </div>
              </div>
            </div>
            <div class="testimonial-card reveal reveal-delay-3">
              <div class="testimonial-card__stars">
                {[1, 2, 3, 4, 5].map(() => <span data-icon="star" set:html={Icons.star}></span>)}
              </div>
              <p class="testimonial-card__quote">
                "I ordered leather aprons for my entire kitchen team. The
                durability and comfort are unmatched — and they look absolutely
                stunning."
              </p>
              <div class="testimonial-card__author">
                <div class="testimonial-card__avatar">MK</div>
                <div>
                  <div class="testimonial-card__name">Marcus Klein</div>
                  <div class="testimonial-card__role">
                    Executive Chef, New York
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══════════ FAQ ═══════════ -->
      <section class="section" aria-labelledby="faq-title">
        <div class="container container--narrow">
          <div class="section-header text-center reveal">
            <span class="section-label">Common Questions</span>
            <h2 class="section-title" id="faq-title">Frequently Asked</h2>
          </div>
          <div class="accordion reveal">
            <div class="accordion__item">
              <button class="accordion__trigger" aria-expanded="false">
                What type of leather do you use?
                <span class="accordion__icon"></span>
              </button>
              <div class="accordion__content">
                <div class="accordion__content-inner">
                  <p>
                    We use full-grain and top-grain leathers sourced from
                    reputable tanneries. Each leather type is selected to best
                    suit the product — calfskin for softness, buffalo for
                    durability, and bridle leather for structure.
                  </p>
                </div>
              </div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" aria-expanded="false">
                How do I care for my leather product?
                <span class="accordion__icon"></span>
              </button>
              <div class="accordion__content">
                <div class="accordion__content-inner">
                  <p>
                    Keep your leather goods dry and store them in the dust bag
                    provided. Clean with a soft cloth and apply a quality
                    leather conditioner every 3–6 months. Avoid prolonged
                    sunlight exposure to prevent fading.
                  </p>
                </div>
              </div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" aria-expanded="false">
                Do you offer custom or bulk orders?
                <span class="accordion__icon"></span>
              </button>
              <div class="accordion__content">
                <div class="accordion__content-inner">
                  <p>
                    Absolutely. We welcome custom orders for corporate gifting,
                    hotel amenities, restaurant aprons, and bespoke personal
                    pieces. Contact us with your requirements and our design
                    team will provide a tailored proposal.
                  </p>
                </div>
              </div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" aria-expanded="false">
                What is the typical lead time for orders?
                <span class="accordion__icon"></span>
              </button>
              <div class="accordion__content">
                <div class="accordion__content-inner">
                  <p>
                    In-stock items ship within 5–7 business days. Made-to-order
                    and custom pieces typically require 3–4 weeks. Bulk orders
                    may have longer lead times — we'll confirm timelines once we
                    understand your needs.
                  </p>
                </div>
              </div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" aria-expanded="false">
                Do you ship internationally?
                <span class="accordion__icon"></span>
              </button>
              <div class="accordion__content">
                <div class="accordion__content-inner">
                  <p>
                    Yes, we ship worldwide via insured carriers. International
                    delivery typically takes 7–14 business days depending on the
                    destination. Customs duties and taxes, if applicable, are
                    the responsibility of the buyer.
                  </p>
                </div>
              </div>
            </div>
            <div class="accordion__item">
              <button class="accordion__trigger" aria-expanded="false">
                How do you pack your products?
                <span class="accordion__icon"></span>
              </button>
              <div class="accordion__content">
                <div class="accordion__content-inner">
                  <p>
                    Every Golden Motif product is carefully wrapped and placed
                    inside a premium-quality dust cover crafted from soft,
                    breathable fabric. Our packaging is designed to protect your
                    leather goods from dust, moisture, and scratches — ensuring
                    they arrive in pristine condition, ready to be cherished.
                  </p>
                  <div class="accordion__gallery">
                    <Image src={asset("ASSESTS/How do w epack your itrms_6/1.png")} alt="Premium dust cover packaging" widths={[480, 800, 1200]} sizes="(max-width: 768px) 100vw, 720px" format="webp" loading="lazy" />
                    <Image src={asset("ASSESTS/How do w epack your itrms_6/3.png")} alt="Leather product wrapped in dust cover" widths={[480, 800, 1200]} sizes="(max-width: 768px) 100vw, 720px" format="webp" loading="lazy" />
                    <Image src={asset("ASSESTS/How do w epack your itrms_6/6.png")} alt="Golden Motif packaging presentation" widths={[480, 800, 1200]} sizes="(max-width: 768px) 100vw, 720px" format="webp" loading="lazy" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══════════ CTA BANNER ═══════════ -->
      <section class="section--sm">
        <div class="container">
          <div class="cta-banner reveal">
            <h2 class="cta-banner__title">Ready to Elevate Your Collection?</h2>
            <p class="cta-banner__text">
              Request our full catalogue or reach out to discuss bespoke options
              tailored to your vision.
            </p>
            <div class="flex gap-md justify-center flex-wrap">
              <a href="/contact/" class="btn btn--accent btn--lg"
                >PARTNER WITH US</a
              >
              <a href="/catalogue/" class="btn btn--white btn--lg"
                >Browse Collection</a
              >
            </div>
          </div>
        </div>
      </section>
    </main>
</Base>
