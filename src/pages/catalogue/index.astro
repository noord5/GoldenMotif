---
import Base from "../../layouts/Base.astro";
import CatalogueView from "../../components/CatalogueView.astro";
import { products, productUrl, SITE } from "../../lib/products.js";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "The Collection",
    url: `${SITE}/catalogue/`,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: products.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${SITE}${productUrl(p)}`,
        name: p.name,
      })),
    },
  },
];
---
<Base
  title="Premium Leather Shoes, Bags, Wallets & Aprons | Golden Motif"
  description="Browse the full Golden Motif catalogue of premium handmade leather shoes, boots, bags, wallets and aprons. Filter by category or search by name."
  ogTitle="Premium Leather Shoes, Bags, Wallets & Aprons | Golden Motif"
  ogDescription="Browse the full Golden Motif catalogue of premium handmade leather shoes, boots, bags, wallets and aprons."
  path="/catalogue/"
  active="catalogue"
  jsonLd={jsonLd}
>
  <CatalogueView />
  <script is:inline slot="scripts" src="/js/catalogue.js" defer></script>
</Base>
